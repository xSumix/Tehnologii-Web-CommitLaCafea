# Server configuration
PORT=3000
NODE_ENV=development

# Database (SQLite file path)
DB_STORAGE=./backend/database.sqlite

# Security / Authentication (replace with a strong random string in local .env)
JWT_SECRET=change_this_to_a_long_random_secret_in_local_env
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# External Compliance Verification Service (mock/local endpoint)
COMPLIANCE_API_URL=http://localhost:3000/api/mock-compliance
COMPLIANCE_API_KEY=dummy_local_key
